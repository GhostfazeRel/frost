<Window x:Class="Frost.App.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}" Title="Frost">
    <Border Margin="24" Padding="24,22" MinWidth="380" MaxWidth="480" CornerRadius="20"
            Background="{StaticResource MenuBgBrush}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1"
            MouseLeftButtonDown="Drag_Down">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="Black"/></Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ProgressBar x:Name="Progress" Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.Name="Download progress"/>
            <TextBox x:Name="Input" Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.Name="Value"/>
            <CheckBox x:Name="Check" Margin="0,14,0,0" Visibility="Collapsed"/>
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"/>
        </StackPanel>
    </Border>
</Window>
