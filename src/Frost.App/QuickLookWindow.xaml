<Window x:Class="Frost.App.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}" Title="Quick Look"
        PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged" Closed="Window_Closed">
    <Border Margin="24" CornerRadius="20" Background="{StaticResource MenuBgBrush}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.55" Color="Black"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Margin="20,14,12,8" MouseLeftButtonDown="Header_Down">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="CounterText" Grid.Column="1" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0"/>
                <Button x:Name="FitButton" Grid.Column="2" Style="{StaticResource PillButton}" Height="28" Padding="12,0" Content="100%" Click="Fit_Click" Visibility="Collapsed"
                        ToolTip="Switch between fit and 100% (F)" AutomationProperties.Name="Fit or 100 percent"/>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="8,0,0,0" Click="Close_Click" ToolTip="Close (Esc)" AutomationProperties.Name="Close Quick Look"/>
            </Grid>

            <Grid Grid.Row="1" Margin="12,0">
                <Grid x:Name="PicHost" Background="Transparent" ClipToBounds="True" Visibility="Collapsed"
                      MouseWheel="Pic_MouseWheel" MouseLeftButtonDown="Pic_Down" MouseLeftButtonUp="Pic_Up" MouseMove="Pic_Move">
                    <Image x:Name="Pic" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ScaleT"/>
                                <TranslateTransform x:Name="MoveT"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
                <TextBox x:Name="TextView" IsReadOnly="True" Visibility="Collapsed" BorderThickness="0" Background="#26000000" Padding="12" AcceptsReturn="True"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         AutomationProperties.Name="File contents"/>
                <StackPanel x:Name="InfoView" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="560">
                    <Image x:Name="InfoIcon" Width="128" Height="128" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="InfoText" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" LineHeight="24"/>
                </StackPanel>
                <TextBlock x:Name="BusyText" Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}" Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="2" Margin="20,8,20,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="← → flip   Space / Esc close   Enter open" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" Margin="16,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
