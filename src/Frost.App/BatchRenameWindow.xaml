<Window x:Class="Frost.App.BatchRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}" Title="Batch rename">
    <Border Margin="24" Padding="24,22" Width="680" CornerRadius="20"
            Background="{StaticResource MenuBgBrush}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1"
            MouseLeftButtonDown="Drag_Down">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="Black"/></Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" x:Key="Lbl"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,0,0,8"/></Style>
                </Grid.Resources>
                <TextBlock Style="{StaticResource Lbl}" Grid.Row="0" Grid.Column="0" Text="Find" Margin="0,0,10,8"/>
                <TextBox x:Name="FindBox" Grid.Row="0" Grid.Column="1" AutomationProperties.Name="Find" TextChanged="Changed"/>
                <TextBlock Style="{StaticResource Lbl}" Grid.Row="0" Grid.Column="3" Text="Replace with" Margin="0,0,10,8"/>
                <TextBox x:Name="ReplaceBox" Grid.Row="0" Grid.Column="4" AutomationProperties.Name="Replace with" TextChanged="Changed"/>
                <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Grid.Column="0" Text="Prefix" Margin="0,0,10,8"/>
                <TextBox x:Name="PrefixBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Prefix" TextChanged="Changed"/>
                <TextBlock Style="{StaticResource Lbl}" Grid.Row="1" Grid.Column="3" Text="Suffix" Margin="0,0,10,8"/>
                <TextBox x:Name="SuffixBox" Grid.Row="1" Grid.Column="4" AutomationProperties.Name="Suffix" TextChanged="Changed"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Orientation="Horizontal">
                    <CheckBox x:Name="RegexCheck" Content="Regex" Margin="0,0,16,0" Checked="Changed" Unchecked="Changed"/>
                    <CheckBox x:Name="CaseCheck" Content="Match case" Margin="0,0,16,0" Checked="Changed" Unchecked="Changed"/>
                    <CheckBox x:Name="ExtCheck" Content="Include extension" Checked="Changed" Unchecked="Changed"/>
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Style="{x:Null}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="Numbering {n}:  start" Margin="0,0,6,0"/>
                <TextBox x:Name="StartBox" Text="1" Width="56" Margin="0,0,10,0" AutomationProperties.Name="Number start" TextChanged="Changed"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="step" Margin="0,0,6,0"/>
                <TextBox x:Name="StepBox" Text="1" Width="56" Margin="0,0,10,0" AutomationProperties.Name="Number step" TextChanged="Changed"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="digits" Margin="0,0,6,0"/>
                <TextBox x:Name="WidthBox" Text="1" Width="56" AutomationProperties.Name="Number digits" TextChanged="Changed"/>
            </StackPanel>
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                       Text="Put {n} in Replace with, Prefix or Suffix to insert the number."/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="Case" Margin="0,0,10,0"/>
                <ToggleButton x:Name="CaseKeep" Style="{StaticResource PillToggle}" IsChecked="True" Content="Unchanged" Click="CaseMode_Click"/>
                <ToggleButton x:Name="CaseLower" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Content="lower" Click="CaseMode_Click"/>
                <ToggleButton x:Name="CaseUpper" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Content="UPPER" Click="CaseMode_Click"/>
                <ToggleButton x:Name="CaseTitle" Style="{StaticResource PillToggle}" Margin="6,0,0,0" Content="Title Case" Click="CaseMode_Click"/>
            </StackPanel>
            <TextBlock x:Name="SummaryText" Margin="0,16,0,6" Foreground="{StaticResource TextSecondaryBrush}"/>
            <Border Background="{StaticResource SubtleFillBrush}" BorderBrush="{StaticResource SubtleRimBrush}" BorderThickness="1" CornerRadius="10" Height="220">
                <ItemsControl x:Name="Preview" Focusable="False" AutomationProperties.Name="Preview of new names">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="6">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2" ToolTip="{Binding Error}" ToolTipService.IsEnabled="{Binding HasError}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Old}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="  →  " Foreground="{StaticResource TextTertiaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding New}" TextTrimming="CharacterEllipsis" Foreground="{Binding Brush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF6B6B" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="OkButton" Content="Rename" MinWidth="84" Style="{StaticResource AccentPill}" IsDefault="True" Click="Ok_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="84" Margin="8,0,0,0" Style="{StaticResource PillButton}" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
