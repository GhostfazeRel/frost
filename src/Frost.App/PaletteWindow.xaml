<Window x:Class="Frost.App.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Frost.App"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="620" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource TextBrush}" Title="Frost"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Border Margin="24" CornerRadius="18" Background="{StaticResource MenuBgBrush}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="Black"/></Border.Effect>
        <StackPanel>
            <Grid Margin="16,12">
                <TextBlock x:Name="Hint" IsHitTestVisible="False" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                <TextBox x:Name="Input" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}" FontSize="16" TextChanged="Input_TextChanged"
                         AutomationProperties.Name="Type to filter"/>
            </Grid>
            <Border Height="1" Background="{StaticResource SubtleRimBrush}"/>
            <ListBox x:Name="Results" MaxHeight="380" Margin="6" BorderThickness="0" Background="Transparent" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="Results_Click"
                     AutomationProperties.Name="Results">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="10" Padding="10,7" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Margin="16,0,0,0" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <local:HighlightBlock TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Empty" Text="No matches" Margin="16,4,16,14" Foreground="{StaticResource TextTertiaryBrush}" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
