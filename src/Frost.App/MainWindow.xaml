<Window x:Class="Frost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Frost.App"
        Title="Frost" Width="1280" Height="800" MinWidth="780" MinHeight="480"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown"
        StateChanged="Window_StateChanged" SizeChanged="Window_SizeChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ===== item containers ===== -->
        <Style x:Key="DetailsItem" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Opacity" Value="{Binding ItemOpacity}"/>
            <Setter Property="ToolTip" Value="{Binding FullPath}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentRimBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Opacity" Value="{Binding ItemOpacity}"/>
            <Setter Property="ToolTip" Value="{Binding FullPath}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="3" CornerRadius="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentRimBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShowWhenRenaming" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="HideWhenRenaming" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>

        <!-- ===== cell templates ===== -->
        <DataTemplate x:Key="NameCell">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="4,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource HideWhenRenaming}"/>
                <TextBox Grid.Column="1" Style="{StaticResource ShowWhenRenaming}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="6,2"
                         IsVisibleChanged="RenameBox_VisibleChanged" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ModifiedCell"><TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="10,0"/></DataTemplate>
        <DataTemplate x:Key="TypeCell"><TextBlock Text="{Binding TypeText}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="10,0"/></DataTemplate>
        <DataTemplate x:Key="SizeCell"><TextBlock Text="{Binding SizeText}" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" Margin="10,0"/></DataTemplate>

        <DataTemplate x:Key="TileCell">
            <Grid Margin="6,8,6,4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Image Source="{Binding Picture}" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                       Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,6,0,0"
                           Style="{StaticResource HideWhenRenaming}"/>
                <TextBox Grid.Row="1" Style="{StaticResource ShowWhenRenaming}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Padding="4,2" TextAlignment="Center"
                         IsVisibleChanged="RenameBox_VisibleChanged" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"/>
            </Grid>
        </DataTemplate>

        <!-- ===== tab ===== -->
        <DataTemplate x:Key="TabTemplate">
            <Border x:Name="Bd" Width="{Binding DataContext.TabWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="32" Margin="0,0,3,0"
                    CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" ToolTip="{Binding Path}"
                    MouseLeftButtonDown="Tab_LeftDown" MouseDown="Tab_MiddleDown" MouseRightButtonUp="Tab_RightUp">
                <Grid Margin="10,0,5,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="Close" Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="9" Content="&#xE8BB;" Opacity="0"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="Close tab" ToolTip="Close tab (Ctrl+W)"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                    <Setter TargetName="Close" Property="Opacity" Value="1"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabActiveBrush}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RimBrush}"/>
                    <Setter TargetName="Close" Property="Opacity" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CrumbTemplate">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}" Tag="{Binding Path}" Click="Crumb_Click"/>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" Margin="1,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===== sidebar ===== -->
        <DataTemplate x:Key="SidebarItemTemplate">
            <Button Style="{StaticResource SidebarButton}" Click="Side_Click" PreviewMouseDown="Side_MouseDown" MouseRightButtonUp="Side_RightUp"
                    AllowDrop="True" DragOver="Side_DragOver" Drop="Side_Drop" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="15" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Visibility="{Binding DriveVisibility}">
                        <ProgressBar Height="4" Value="{Binding UsedPercent, Mode=OneWay}"/>
                        <TextBlock Text="{Binding FreeText}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate">
            <StackPanel Margin="0,0,0,8">
                <ToggleButton Style="{StaticResource SectionHeader}" Content="{Binding Title}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"/>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SidebarItemTemplate}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}"/>
                <TextBlock Text="{Binding Hint}" Visibility="{Binding HintVisibility}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="12,2,8,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OperationTemplate">
            <Border Width="340" Margin="0,8,0,0" Padding="16,14" CornerRadius="18" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.45"/></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentItem}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,8"/>
                        <ProgressBar Value="{Binding Percent, Mode=OneWay}"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" Width="28" Height="28" VerticalAlignment="Top" Margin="8,0,0,0"
                            Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel operation" ToolTip="Cancel"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource WindowTintBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ===== title bar with tabs ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="TabStrip" Margin="10,4,0,0" ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource TabTemplate}"
                              WindowChrome.IsHitTestVisibleInChrome="True" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;" Width="30" Height="30" Margin="2,4,0,0" FontSize="13"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="NewTab_Click" ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" AutomationProperties.Name="Minimize"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" AutomationProperties.Name="Maximize"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Close"/>
                </StackPanel>
            </Grid>

            <!-- ===== navigation row ===== -->
            <Grid Grid.Row="1" Margin="12,2,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" IsEnabled="{Binding CurrentTab.CanGoBack}" Click="Back_Click" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72A;" IsEnabled="{Binding CurrentTab.CanGoForward}" Click="Forward_Click" ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Click="Up_Click" ToolTip="Up (Alt+Up)" AutomationProperties.Name="Up one level"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Refresh_Click" ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh"/>
                </StackPanel>

                <Border x:Name="AddressBorder" Grid.Column="1" Height="36" CornerRadius="18" Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource SubtleRimBrush}" BorderThickness="1" Padding="10,0" MouseLeftButtonDown="Address_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="2,0,8,0"/>
                        <ScrollViewer x:Name="CrumbScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding CurrentTab.Crumbs}" ItemTemplate="{StaticResource CrumbTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBox x:Name="AddressBox" Grid.Column="1" Visibility="Collapsed" BorderThickness="0" Background="Transparent" Padding="0,2"
                                 KeyDown="AddressBox_KeyDown" LostKeyboardFocus="AddressBox_LostFocus" AutomationProperties.Name="Address"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Width="260" Height="36" CornerRadius="18" Margin="8,0,0,0" Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource SubtleRimBrush}" BorderThickness="1" Padding="12,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0,2"
                                 Text="{Binding CurrentTab.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_KeyDown" ToolTip="Filter this folder as you type. Press Enter to search subfolders. (Ctrl+F)" AutomationProperties.Name="Search"/>
                        <TextBlock Grid.Column="1" Text="Filter, Enter to search subfolders" IsHitTestVisible="False" Foreground="{StaticResource TextTertiaryBrush}" Margin="2,0,0,0" VerticalAlignment="Center" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== command bar ===== -->
            <Grid Grid.Row="2" Margin="12,0,12,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="NewButton" Style="{StaticResource PillButton}" Click="New_Click" AutomationProperties.Name="New" ToolTip="Create a new item">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="New" VerticalAlignment="Center"/><TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PillButton}" Margin="12,0,0,0" Padding="11,0" IsEnabled="{Binding CurrentTab.HasSelection}" Click="Cut_Click" ToolTip="Cut (Ctrl+X)" AutomationProperties.Name="Cut">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;"/></Button>
                    <Button Style="{StaticResource PillButton}" Margin="6,0,0,0" Padding="11,0" IsEnabled="{Binding CurrentTab.HasSelection}" Click="Copy_Click" ToolTip="Copy (Ctrl+C)" AutomationProperties.Name="Copy">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/></Button>
                    <Button Style="{StaticResource PillButton}" Margin="6,0,0,0" Padding="11,0" Click="Paste_Click" ToolTip="Paste (Ctrl+V)" AutomationProperties.Name="Paste">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;"/></Button>
                    <Button Style="{StaticResource PillButton}" Margin="6,0,0,0" Padding="11,0" IsEnabled="{Binding CurrentTab.HasSelection}" Click="Rename_Click" ToolTip="Rename (F2)" AutomationProperties.Name="Rename">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AC;"/></Button>
                    <Button Style="{StaticResource PillButton}" Margin="6,0,0,0" Padding="11,0" IsEnabled="{Binding CurrentTab.HasSelection}" Click="Delete_Click" ToolTip="Delete (Del)" AutomationProperties.Name="Delete">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;"/></Button>
                    <Button x:Name="SortButton" Style="{StaticResource PillButton}" Margin="12,0,0,0" Click="Sort_Click" AutomationProperties.Name="Sort" ToolTip="Sort by">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" Margin="0,0,8,0"/><TextBlock Text="Sort" VerticalAlignment="Center"/><TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="ViewButton" Style="{StaticResource PillButton}" Margin="6,0,0,0" Click="View_Click" AutomationProperties.Name="View" ToolTip="Change view">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A9;" Margin="0,0,8,0"/><TextBlock Text="View" VerticalAlignment="Center"/><TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource PillToggle}" Padding="11,0" IsChecked="{Binding PreviewPane, Mode=TwoWay}" ToolTip="Preview pane (Alt+P)" AutomationProperties.Name="Preview pane">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C3;"/></ToggleButton>
                    <Button Style="{StaticResource PillButton}" Margin="6,0,0,0" Padding="11,0" Click="Terminal_Click" ToolTip="Open terminal here" AutomationProperties.Name="Open terminal here">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE756;"/></Button>
                    <Button x:Name="MoreButton" Style="{StaticResource PillButton}" Margin="6,0,0,0" Padding="11,0" Click="More_Click" ToolTip="More options" AutomationProperties.Name="More options">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;"/></Button>
                </StackPanel>
            </Grid>

            <!-- ===== content ===== -->
            <Grid Grid.Row="3" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GlassPanel}" Grid.Column="0" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" Focusable="False"/>
                    </ScrollViewer>
                </Border>

                <Border Style="{StaticResource GlassPanel}" Grid.Column="2" Padding="6">
                    <Grid>
                        <ListView x:Name="DetailsList" ItemsSource="{Binding CurrentTab.Items}" SelectionMode="Extended"
                                  Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                  ItemContainerStyle="{StaticResource DetailsItem}" FocusVisualStyle="{x:Null}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" TextSearch.TextPath="Name" IsTextSearchEnabled="True"
                                  AllowDrop="True" Visibility="{Binding IsDetails, Converter={StaticResource B2V}}"
                                  SelectionChanged="List_SelectionChanged" GridViewColumnHeader.Click="Header_Click"
                                  PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                                  PreviewMouseMove="List_PreviewMouseMove" PreviewMouseDown="List_PreviewMouseDown"
                                  PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown" PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp"
                                  DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop" PreviewMouseWheel="List_PreviewMouseWheel"
                                  AutomationProperties.Name="Files">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource DetailsHeader}">
                                    <GridViewColumn Header="Name" Width="380" CellTemplate="{StaticResource NameCell}"/>
                                    <GridViewColumn Header="Date modified" Width="170" CellTemplate="{StaticResource ModifiedCell}"/>
                                    <GridViewColumn Header="Type" Width="150" CellTemplate="{StaticResource TypeCell}"/>
                                    <GridViewColumn Header="Size" Width="100" CellTemplate="{StaticResource SizeCell}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <ListBox x:Name="IconList" ItemsSource="{Binding CurrentTab.Items}" SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                 ItemContainerStyle="{StaticResource TileItem}" ItemTemplate="{StaticResource TileCell}" FocusVisualStyle="{x:Null}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 TextSearch.TextPath="Name" IsTextSearchEnabled="True"
                                 AllowDrop="True" Visibility="{Binding IsIcons, Converter={StaticResource B2V}}"
                                 SelectionChanged="List_SelectionChanged" PreviewKeyDown="IconList_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                                 PreviewMouseMove="List_PreviewMouseMove" PreviewMouseDown="List_PreviewMouseDown"
                                 PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown" PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp"
                                 DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop" PreviewMouseWheel="List_PreviewMouseWheel"
                                 AutomationProperties.Name="Files">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:VirtualizingWrapPanel
                                        ItemWidth="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ItemHeight="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                    Visibility="{Binding CurrentTab.ShowOverlay, Converter={StaticResource B2V}}">
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding CurrentTab.OverlayGlyph}" FontSize="44" Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding CurrentTab.OverlayText}" Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== preview pane ===== -->
                <Border Style="{StaticResource GlassPanel}" Grid.Column="3" Width="300" Margin="10,0,0,0" Padding="18"
                        DataContext="{Binding Preview}" Visibility="{Binding DataContext.PreviewPane, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource B2V}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <Image Source="{Binding Picture}" MaxHeight="200" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,10" TextAlignment="Center"/>
                            <TextBlock Text="{Binding TypeText}" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Size" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3"/>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Text="Modified" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModifiedText}" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Text="Created" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreatedText}" TextWrapping="Wrap" Margin="0,3"/>
                            </Grid>
                            <Border Margin="0,14,0,0" Padding="10" CornerRadius="12" Background="#26000000" Visibility="{Binding HasText, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding TextContent}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="NoWrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== status bar ===== -->
            <Grid Grid.Row="4" Margin="24,0,24,0" TextElement.FontSize="12" TextElement.Foreground="{StaticResource TextSecondaryBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CurrentTab.CountText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding CurrentTab.SelectionText}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTab.StatusBusy}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <Button Content="Cancel" Style="{StaticResource PillButton}" Height="22" Padding="10,0" FontSize="11" Margin="8,0,0,0"
                            Command="{Binding CancelSearchCommand}" Visibility="{Binding CurrentTab.IsSearching, Converter={StaticResource B2V}}"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding Notice}" Margin="18,0,18,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Grid.Column="4" Text="{Binding CurrentTab.FreeText}" VerticalAlignment="Center"/>
            </Grid>

            <!-- ===== operations ===== -->
            <ItemsControl Grid.Row="3" Grid.RowSpan="2" ItemsSource="{Binding Operations}" ItemTemplate="{StaticResource OperationTemplate}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,30" Focusable="False"/>
        </Grid>
    </Border>
</Window>
