<Window x:Class="Frost.App.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Width="940" Height="720" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}" Title="Find duplicate files"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded" Closed="Window_Closed">
    <Border Margin="24" CornerRadius="20" Background="{StaticResource MenuBgBrush}" BorderBrush="{StaticResource RimBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="Black"/></Border.Effect>
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_Down">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Find duplicate files" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="Close (Esc)" AutomationProperties.Name="Close"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Height="34" CornerRadius="17" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource SubtleRimBrush}" BorderThickness="1" Padding="14,0">
                    <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterStartEllipsis" AutomationProperties.Name="Folder to scan"/>
                </Border>
                <Button Grid.Column="1" Style="{StaticResource PillButton}" Margin="8,0,0,0" Content="Choose folder…" Click="Choose_Click"/>
                <Button x:Name="ScanButton" Grid.Column="2" Style="{StaticResource AccentPill}" Margin="8,0,0,0" Padding="16,0" Content="Scan" Click="Scan_Click"/>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,10,0,8" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            <Border Grid.Row="3" Background="{StaticResource SubtleFillBrush}" BorderBrush="{StaticResource SubtleRimBrush}" BorderThickness="1" CornerRadius="12">
                <ItemsControl x:Name="GroupList" Focusable="False" AutomationProperties.Name="Duplicate groups">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="8"><ItemsPresenter/></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="4,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2" Background="Transparent" MouseLeftButtonDown="File_Down">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Path, StringFormat=Select {0}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterStartEllipsis" Margin="8,0" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource PillButton}" Content="Keep newest" Click="KeepNewest_Click" ToolTip="In every group, tick all copies except the newest"/>
                <Button Grid.Column="1" Style="{StaticResource PillButton}" Margin="8,0,0,0" Content="Keep oldest" Click="KeepOldest_Click" ToolTip="In every group, tick all copies except the oldest"/>
                <Button Grid.Column="2" Style="{StaticResource PillButton}" Margin="8,0,0,0" Content="Clear ticks" Click="Clear_Click"/>
                <TextBlock x:Name="SelectedText" Grid.Column="3" Margin="14,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button x:Name="MoveButton" Grid.Column="4" Style="{StaticResource AccentPill}" Padding="16,0" Content="Move ticked to Recycle Bin" Click="Move_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
